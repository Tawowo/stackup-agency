{
  "name": "stackup-agency",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "shots": "node --experimental-strip-types --no-warnings scripts/shots.mjs",
    "shots:home": "node --experimental-strip-types --no-warnings scripts/shots.mjs --route=/",
    "lab": "node scripts/lab.mjs",
    "logo:trace": "node scripts/logo-trace.mjs",
    "logo:check": "node scripts/logo-check.mjs",
    "cadence": "node scripts/cadence.mjs",
    "videos": "node scripts/videos.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@use-gesture/react": "^10.3.1",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "maath": "^0.10.8",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tweakpane": "^4.0.5",
    "typescript": "^5.9.3"
  }
}
