# Variables d'environnement de Stackup Agency.
# Copier ce fichier en `.env.local` et remplir les valeurs.

# Envoi des e-mails (formulaires contact, devis, parrainage).
# Sans cette clé, les routes /api/contact et /api/parrainage répondent 503
# explicitement plutôt que d'échouer en silence.
RESEND_API_KEY=re_votre_cle_ici

# Audit de site (/outils/audit-site) : proxy vers PageSpeed Insights.
# Sans cette clé, l'audit répond 503. Clé gratuite à créer sur
# https://console.cloud.google.com → API PageSpeed Insights.
PAGESPEED_API_KEY=votre_cle_pagespeed_ici
